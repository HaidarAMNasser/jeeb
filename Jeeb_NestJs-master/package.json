{
  "name": "delivery-jeeb",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed:users": "ts-node scripts/seed-users.ts",
    "seed:admins": "ts-node scripts/seed-admin-merchants.ts",
    "seed:stress": "ts-node scripts/stress-test-seeder.ts",
    "seed:loadtest": "ts-node scripts/seed-load-test-users.ts",
    "seed:large": "ts-node scripts/large-scale-seeder.ts",
    "loadtest": "cd load-tests && powershell -ExecutionPolicy Bypass -File run.ps1",
    "loadtest:auth": "cd load-tests && powershell -ExecutionPolicy Bypass -File run.ps1 -Scenario auth",
    "loadtest:order": "cd load-tests && powershell -ExecutionPolicy Bypass -File run.ps1 -Scenario order",
    "loadtest:delivery": "cd load-tests && powershell -ExecutionPolicy Bypass -File run.ps1 -Scenario delivery",
    "loadtest:mixed": "cd load-tests && powershell -ExecutionPolicy Bypass -File run.ps1 -Scenario mixed",
    "loadtest:breakpoint": "cd load-tests && powershell -ExecutionPolicy Bypass -File run.ps1 -Scenario breakpoint",
    "loadtest:soak": "cd load-tests && powershell -ExecutionPolicy Bypass -File run.ps1 -Scenario soak",
    "loadtest:local": "cd load-tests && powershell -ExecutionPolicy Bypass -File run.ps1 -Local -Scenario mixed",
    "loadtest:local:auth": "cd load-tests && powershell -ExecutionPolicy Bypass -File run.ps1 -Local -Scenario auth",
    "loadtest:local:order": "cd load-tests && powershell -ExecutionPolicy Bypass -File run.ps1 -Local -Scenario order",
    "loadtest:local:delivery": "cd load-tests && powershell -ExecutionPolicy Bypass -File run.ps1 -Local -Scenario delivery",
    "loadtest:local:mixed": "cd load-tests && powershell -ExecutionPolicy Bypass -File run.ps1 -Local -Scenario mixed",
    "loadtest:local:breakpoint": "cd load-tests && powershell -ExecutionPolicy Bypass -File run.ps1 -Local -Scenario breakpoint",
    "loadtest:local:soak": "cd load-tests && powershell -ExecutionPolicy Bypass -File run.ps1 -Local -Scenario soak",
    "seed:restaurants": "ts-node scripts/seed-restaurants-orders.ts",
    "seed:restaurants-orders": "ts-node scripts/seed-restaurants-orders.ts",
    "seed:all": "ts-node scripts/seed-users.ts && ts-node scripts/seed-restaurants-orders.ts",
    "db:init": "ts-node scripts/init-db.ts",
    "db:sync": "ts-node scripts/sync-schema.ts",
    "db:reset": "ts-node scripts/reset-db.ts",
    "db:delete-orders": "ts-node scripts/delete-orders-by-ids.ts",
    "db:reset-order": "ts-node scripts/reset-order-to-pending.ts",
    "db:reset-settings": "ts-node scripts/reset-settings.ts",
    "db:fix-user-merchant": "ts-node scripts/fix-user-merchant-constraint.ts",
    "db:fix-user-merchant:v2": "ts-node scripts/fix-user-merchant-constraint-v2.ts",
    "seed:location": "ts-node scripts/seed-location.ts",
    "db:fix-duplicate-phones": "ts-node scripts/fix-duplicate-phones.ts",
    "db:update-hide-phone": "ts-node scripts/update-hide-phone-number.ts",
    "db:sync-drivers-firebase": "ts-node scripts/sync-drivers-to-firebase.ts",
    "db:sync-driver-firebase": "ts-node -e \"const id=process.argv[2]; if(!id){console.error('Usage: npm run db:sync-driver-firebase -- <driver_id>');process.exit(1);} require('./scripts/sync-driver-to-firebase').syncDriverToFirebase(parseInt(id))\" --",
    "db:delete-unverified": "ts-node scripts/delete-unverified-users.ts",
    "db:delete-user": "ts-node scripts/delete-user-by-id.ts",
    "db:delete-user-by-email": "ts-node scripts/delete-user-by-email.ts",
    "db:find-user": "ts-node scripts/find-user-by-email.ts",
    "db:list-guest": "ts-node scripts/list-guest-users.ts",
    "db:list-users": "ts-node scripts/list-all-users.ts",
    "db:delete-guest": "ts-node scripts/delete-guest-users.ts",
    "db:reset-password": "ts-node scripts/reset-password-by-email.ts",
    "db:unblock": "ts-node scripts/unblock-user.ts",
    "db:create-admin": "ts-node scripts/create-admin.ts",
    "db:set-notification-firebase": "ts-node scripts/set-all-users-notification-channel-to-firebase.ts",
    "db:migrate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/data-source.ts"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.14",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.69.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.3.1",
    "firebase-admin": "^13.6.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.3",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.1",
    "openai": "^6.32.0",
    "pg": "^8.18.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "wasenderapi": "^0.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/unit/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
