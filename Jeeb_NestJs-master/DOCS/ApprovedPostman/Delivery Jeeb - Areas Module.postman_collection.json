{
  "info": {
    "_postman_id": "areas-api-postman-collection",
    "name": "Delivery Jeeb - Areas Module",
    "description": "Areas CRUD API - Create, Read, Update, Delete delivery areas with pagination, search, and price filters",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "46725728"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    const token = jsonData.data?.access_token || jsonData.access_token;",
                  "    if (token) {",
                  "        pm.collectionVariables.set('admin_token', token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@jeeb.com\",\n    \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Login Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    const token = jsonData.data?.access_token || jsonData.access_token;",
                  "    if (token) {",
                  "        pm.collectionVariables.set('customer_token', token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"samacustomer@jeeb.com\",\n    \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Areas",
      "item": [
        {
          "name": "Create Area (Admin Only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.id) {",
                  "        pm.collectionVariables.set('areaId', jsonData.data.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Downtown\",\n    \"price\": 5000,\n    \"description\": \"Central business district delivery zone\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/areas",
              "host": ["{{baseUrl}}"],
              "path": ["areas"]
            }
          },
          "response": []
        },
        {
          "name": "Get All Areas (Authenticated)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customer_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/areas?page=1&limit=10&search=downtown&min_price=1000&max_price=10000",
              "host": ["{{baseUrl}}"],
              "path": ["areas"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "search",
                  "value": "downtown"
                },
                {
                  "key": "min_price",
                  "value": "1000"
                },
                {
                  "key": "max_price",
                  "value": "10000"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Area By ID (Authenticated)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customer_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/areas/{{areaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["areas", "{{areaId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Update Area (Admin Only)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Updated Downtown\",\n    \"price\": 6000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/areas/{{areaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["areas", "{{areaId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Delete Area (Admin Only)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/areas/{{areaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["areas", "{{areaId}}"]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "customer_token",
      "value": ""
    },
    {
      "key": "areaId",
      "value": "1"
    }
  ]
}
