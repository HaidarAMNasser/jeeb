  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "",
          "// Check if token exists, if not warn user",
          "if (!pm.collectionVariables.get('token') || pm.collectionVariables.get('token') === 'your_token_here') {",
          "    console.log('Warning: Token not set. Please run Login request first.');",
          "}"
        ],
        "type": "text/javascript"
      }
    },
    {
      "listen": "test",
      "script": {
        "exec": [
          "",
          "// Check response time",
          "const responseTime = pm.response.responseTime;",
          "console.log('Response time:', responseTime, 'ms');",
          "",
          "// Check if request was successful",
          "if (pm.response.code >= 200 && pm.response.code < 300) {",
          "    console.log('Request successful!');",
          "} else {",
          "    console.log('Request failed with status:', pm.response.code);",
          "}"
        ],
        "type": "text/javascript"
      }
    }
