						"value": "Bearer {{admin_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/users/merchants/{{merchant_id}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"users",
						"merchants",
						"{{merchant_id}}"
					]
				}
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:3000",
			"type": "string"
		},
		{
			"key": "admin_token",
			"value": "your_admin_jwt_token_here",
			"type": "string"
		},
		{
			"key": "merchant_id",
			"value": "1",
			"type": "string"
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Log request details for debugging",
					"console.log('Request URL: ' + request.url);",
					"console.log('Request Method: ' + request.method);",
					"console.log('Request Headers: ' + JSON.stringify(request.headers));"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Basic response validation",
					"pm.test('Status code is successful', function () {",
					"    pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]);",
					"});",
					"",
					"pm.test('Response has proper structure', function () {",
					"    const responseJson = pm.response.json();",
					"    pm.expect(responseJson).to.have.property('statusCode');",
					"    pm.expect(responseJson).to.have.property('message');",
					"    pm.expect(responseJson).to.have.property('timestamp');",
					"});",
					"",
					"// Store merchant ID from create response for use in other requests",
					"if (pm.response.code === 201 && responseJson.data && responseJson.data.id) {",
					"    pm.globals.set('merchant_id', responseJson.data.id);",
					"    console.log('Stored merchant_id: ' + responseJson.data.id);",
					"}"
				]
			}
		}
	]
}
