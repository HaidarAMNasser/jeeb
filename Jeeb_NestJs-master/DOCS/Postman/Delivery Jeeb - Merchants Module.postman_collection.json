						"value": "multipart/form-data",
						"type": "text"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{admin_token}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "email",
							"value": "merchant@example.com",
							"type": "text"
						},
						{
							"key": "password",
							"value": "password123",
							"type": "text"
						},
						{
							"key": "firstName",
							"value": "Ahmed",
							"type": "text"
						},
						{
							"key": "lastName",
							"value": "Mohammed",
							"type": "text"
						},
						{
							"key": "phone",
							"value": "+966501234567",
							"type": "text"
						},
						{
							"key": "countryId",
							"value": "1",
							"type": "text"
						},
						{
							"key": "cityId",
							"value": "1",
							"type": "text"
						},
						{
							"key": "address",
							"value": "Riyadh, Saudi Arabia",
							"type": "text"
						},
						{
							"key": "birthday",
							"value": "1990-01-01",
							"type": "text"
						},
						{
							"key": "image",
							"type": "file",
							"src": []
						}
					]
				},
				"url": {
					"raw": "{{base_url}}/api/v1/users/merchants",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"users",
						"merchants"
					]
				}
			},
			"response": []
		},
		{
			"name": "Get All Merchants (Admin Only)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{admin_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/users/merchants?page=1&limit=10&search=ahmed&countryId=1",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"users",
						"merchants"
					],
					"query": [
						{
							"key": "page",
							"value": "1",
							"description": "Page number for pagination"
						},
						{
							"key": "limit",
							"value": "10",
							"description": "Number of items per page"
						},
						{
							"key": "search",
							"value": "ahmed",
							"description": "Search by name, email, or phone"
						},
						{
							"key": "countryId",
							"value": "1",
							"description": "Filter by country ID"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Search Merchants (Admin Only)",
			"request": {
				"method": "GET",
				"header": [
