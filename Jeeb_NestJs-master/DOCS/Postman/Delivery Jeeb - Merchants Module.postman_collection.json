							"type": "text"
						},
						{
							"key": "lastName",
							"value": "Updated Last Name",
							"type": "text"
						},
						{
							"key": "phone",
							"value": "+966507654321",
							"type": "text"
						},
						{
							"key": "countryId",
							"value": "2",
							"type": "text"
						},
						{
							"key": "cityId",
							"value": "2",
							"type": "text"
						},
						{
							"key": "address",
							"value": "Updated Address",
							"type": "text"
						},
						{
							"key": "image",
							"type": "file",
							"src": []
						}
					]
				},
				"url": {
					"raw": "{{base_url}}/api/v1/users/merchants/{{merchant_id}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"users",
						"merchants",
						"{{merchant_id}}"
					]
				}
			},
			"response": []
