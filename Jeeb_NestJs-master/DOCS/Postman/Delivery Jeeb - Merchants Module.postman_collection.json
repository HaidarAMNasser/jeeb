					],
					"path": [
						"api",
						"v1",
						"users",
						"merchants",
						"search"
					],
					"query": [
						{
							"key": "query",
							"value": "john",
							"description": "Search query for merchant name, email, or phone"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Get Merchant by ID (Admin Only)",
			"request": {
				"method": "GET",
				"header": [
